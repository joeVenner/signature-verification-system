# Copy to `.env` (git-ignored) and edit. Variables already set in the shell take precedence.
# Loaded by `python -m signature_verification_system.serve` before numpy / OpenCV start.

# --- Server -------------------------------------------------------------------
SIGVERIFY_HOST=127.0.0.1
SIGVERIFY_PORT=8765
# Comma-separated browser origins allowed to call the API from another site.
SIGVERIFY_CORS_ORIGINS=http://localhost:8765

# --- Console sample gallery (optional) ----------------------------------------
# Folder laid out like data/samples (genuine_pairs/, skilled_forgeries/ with manifest.json).
# Leave empty to disable the gallery.
SIGVERIFY_SAMPLES_DIR=

# --- Audit ledger --------------------------------------------------------------
# Relative paths resolve against the working directory. Empty = built-in default.
SIGVERIFY_AUDIT_DB_PATH=audit_ledger.db
SIGVERIFY_AUDIT_JSONL_PATH=audit_ledger.jsonl

# --- Limits --------------------------------------------------------------------
# Largest image OpenCV will decode (pixels); decompression-bomb guard.
OPENCV_IO_MAX_IMAGE_PIXELS=50000000

# --- CPU threads (determinism + speed; see docs/DETERMINISM.md) ---------------------
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1
